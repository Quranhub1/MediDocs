rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /RESOURCES_STUDYPEDIA/{courseId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'kaigwaakram123@gmail.com';

      match /semesters/{semesterId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.token.email == 'kaigwaakram123@gmail.com';

        match /courseunits/{unitId} {
          allow read: if request.auth != null;
          allow write: if request.auth != null && request.auth.token.email == 'kaigwaakram123@gmail.com';

          match /documents/{docId} {
            allow read: if request.auth != null;
            allow write: if request.auth != null && request.auth.token.email == 'kaigwaakram123@gmail.com';
          }
        }

        match /documents/{docId} {
          allow read: if request.auth != null;
          allow write: if request.auth != null && request.auth.token.email == 'kaigwaakram123@gmail.com';
        }
      }
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && request.auth.token.email == 'kaigwaakram123@gmail.com';
      allow update: if request.auth != null && request.auth.uid == userId 
                   && request.resource.data.keys().hasAll(['name', 'phone']) 
                   && request.resource.data.size() <= 5;
      allow write: if request.auth != null && request.auth.token.email == 'kaigwaakram123@gmail.com';
      allow create: if request.auth != null;
    }

    match /payments/{paymentId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId
                  || request.auth != null && request.auth.token.email == 'kaigwaakram123@gmail.com';
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.email == 'kaigwaakram123@gmail.com';
    }

    match /user_payments/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId
                  || request.auth != null && request.auth.token.email == 'kaigwaakram123@gmail.com';
      allow write: if request.auth != null && request.auth.token.email == 'kaigwaakram123@gmail.com';
    }

    match /chats/{userId}/messages/{msgId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /contact_submissions/{submissionId} {
      allow create: if request.auth == null || request.auth != null;
      allow read: if request.auth != null && request.auth.token.email == 'kaigwaakram123@gmail.com';
      allow update, delete: if request.auth != null && request.auth.token.email == 'kaigwaakram123@gmail.com';
    }

    match /analytics/{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == 'kaigwaakram123@gmail.com';
    }

    match /config/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'kaigwaakram123@gmail.com';
    }

    match /course_ratings/{courseId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId
                            || request.auth != null && request.auth.token.email == 'kaigwaakram123@gmail.com';
    }

    match /user_bookmarks/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /study_progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /download_history/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId
                         || request.auth != null && request.auth.token.email == 'kaigwaakram123@gmail.com';
    }

    match /notifications/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /announcements/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'kaigwaakram123@gmail.com';
    }

    match /documents/{document=**} {
      allow read: if request.auth != null && request.auth.token.email == 'kaigwaakram123@gmail.com';
      allow write: if request.auth != null && request.auth.token.email == 'kaigwaakram123@gmail.com';
    }

    match /trending/{trendId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'kaigwaakram123@gmail.com';
    }
  }
}
